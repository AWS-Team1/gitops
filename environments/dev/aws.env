# =============================================================================
# dev / aws 환경 입력값
#
# 여기에는 Terraform이 만들어주지 않는 값만 둔다.
# Terraform이 만드는 값(EKS 이름, RDS endpoint, master secret ARN, ECR 레지스트리,
# region, account id)은 `terraform output -json`에서 읽으므로 여기 적지 않는다.
#
# 비밀값(비밀번호, 토큰, PAT)은 절대 이 파일에 넣지 않는다. 이 파일은 Git에 커밋된다.
# 형식은 KEY=VALUE 만 허용한다 (스크립트가 검사한다).
# =============================================================================

NAMESPACE=bank-of-anthos

# Argo CD 가 동기화할 Git 브랜치.
# 저장소 URL 은 `git remote get-url origin` 에서 유도하므로 여기 적지 않는다.
# (다른 URL 을 쓰려면 GITOPS_REPO_URL 을 설정한다.)
GIT_TARGET_REVISION=dev

# 논리 DB 이름. RDS 가 만드는 DB(terraform output rds_bootstrap_db_name)와 별개로
# infra/boa/k8s/db-bootstrap-job.yaml 이 이 두 개를 생성한다.
ACCOUNTS_DB_NAME=accountsdb
LEDGER_DB_NAME=ledgerdb

# --- Terraform 관리 대상이 아닌 값 -------------------------------------------

# ECR 레지스트리 호스트. 비워두면 terraform output ecr_registry 를 사용한다.
# (ECR 리포지토리 자체는 아직 Terraform 관리 대상이 아니므로 사전에 존재해야 한다.)
ECR_REGISTRY=

# 애플리케이션을 ALB Ingress 로 외부에 노출할지 여부.
# false 면 Ingress 를 렌더링하지 않는다(포트포워딩으로만 접근).
# false 일 때는 INGRESS_HOST / ACM_CERTIFICATE_ARN / ALB_SSL_POLICY 가 무시된다.
ENABLE_APP_INGRESS=false

# Ingress 호스트명. ENABLE_APP_INGRESS=true 일 때만 쓰인다.
# 비워두면 host 규칙 없이 ALB DNS 로만 접근한다. 예: app.example.com
INGRESS_HOST=app.bespinglobal.site

# ACM 인증서 ARN. 설정하면 ALB 에 HTTPS(443) 리스너가 추가된다.
# 비워두면 HTTP(80)만 사용한다. ACM 은 Terraform 관리 대상이 아니므로
# 값을 넣으려면 실제로 존재하는 ARN 이어야 한다. INGRESS_HOST 도 함께 필요하다.
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:769413326616:certificate/1c81ee2e-edbc-4a42-961d-816d571767ab

# ALB TLS 정책. ACM_CERTIFICATE_ARN 이 설정된 경우에만 렌더링된다.
# 비워두면 ALB 기본 정책을 쓴다.
ALB_SSL_POLICY=ELBSecurityPolicy-TLS13-1-2-2021-06

# Argo CD server 를 기존 ALB Target Group 에 붙일 때만 설정한다.
# 설정하면 argocd/targetgroupbinding.yaml 이 렌더링되고,
# elbv2.k8s.aws/TargetGroupBinding CRD(AWS Load Balancer Controller)가 필요하다.
# 비워두면 해당 리소스를 만들지 않는다.
ARGOCD_TARGET_GROUP_ARN=

# Argo CD Helm chart 버전 (--apply 시 설치/업그레이드에 사용)
ARGOCD_CHART_VERSION=10.4.0
